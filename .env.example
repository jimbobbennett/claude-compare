# Anthropic — the blog writer authenticates with an explicit API key so the
# model is pinned and per-run cost is real.
ANTHROPIC_API_KEY=sk-ant-...

# Arize AX tracing
ARIZE_API_KEY=...
ARIZE_SPACE_ID=...
# The experiment's own Arize project. Defaults to claude-compare-blogwriter.
# Deliberately NOT ARIZE_PROJECT_NAME, which is often already set in the shell
# for unrelated tracing.
BLOGWRITER_PROJECT_NAME=claude-compare-blogwriter

# Only set this if your Arize account is not in the US region.
# ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1
